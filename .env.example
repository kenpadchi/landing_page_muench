# Kopie als ".env" anlegen und ausfüllen. ".env" ist per .gitignore ausgeschlossen.
# Zugangsdaten = KAS-/FTP-Login bei ALL-INKL (SSH/SFTP im KAS unter "Tools > SSH-Zugang" aktivieren).
DEPLOY_HOST=w022514b.kasserver.com
DEPLOY_USER=w022514b
DEPLOY_PASS=hier-das-passwort
DEPLOY_PATH=/www/htdocs/w022514b/alltagsengel-muench.de/
# sftp (Standard) oder ftps, falls SSH beim Tarif nicht freigeschaltet ist
DEPLOY_PROTOCOL=sftp
